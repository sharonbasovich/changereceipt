    "encoding": "UTF-8; optional leading BOM is preserved in originalBase64 and rawText and excluded only from header parsing.",
    "csv": "Comma-delimited, first record headers; quoted fields may contain commas, doubled quotes and record endings. Only a terminal separator-created blank record is ignored.",
    "identifiers": "Exact string equality. No trimming, case conversion, number conversion or guessed ID columns.",
    "duplicateIds": "If either snapshot has multiple rows with an ID, the entire ID group is ambiguous. No matching is attempted for that group.",
    "missingIds": "Empty-string and missing IDs are unresolved individual records. They are excluded from normal change counts.",
    "values": "Mapped fields use exact string equality. Empty string is an existing empty cell; null is a missing cell or an explicitly unmapped side.",
    "scope": "Only mapped fields participate. Other source columns are preserved but excluded. Quantities are compared as text; no totals or real-world movement are inferred.",
    "counts": "Added, removed, changed and unchanged count unique unambiguous IDs. Ambiguous counts ID groups. InvalidKey counts individual source records.",
    "ordering": "ID groups sort by JavaScript UTF-16 code unit order. Invalid-ID records follow in before-then-after source order.",
    "records": "Record is a CSV record ordinal: header is 1, first data record is 2. A quoted multiline field does not create an extra record.",
    "evidence": "originalBase64 preserves original file bytes. sha256 is the SHA-256 of those bytes. Fingerprints identify supplied bytes; they do not authenticate their origin."
